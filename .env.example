# Neon / Postgres
# Copy to .env and fill real values (never commit .env).
# Prefer JDBC form for Spring Boot:
#   DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   DATABASE_USERNAME=neondb_owner
#   DATABASE_PASSWORD=...
# postgresql://… URLs from Neon/Render are also accepted (auto-converted).
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/medicore
DATABASE_USERNAME=medicore
DATABASE_PASSWORD=medicore
JWT_SECRET=medicore-dev-jwt-secret-change-in-production
PORT=4110
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
APP_URL=http://127.0.0.1:3000
# Production (Render + Vercel):
# CORS_ORIGIN=https://medicore-health-mm.vercel.app
# APP_URL=https://medicore-health-mm.vercel.app

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:care@medicore.local

# Medicore Assist (Gemini) — server-side only; never put this in web/ or mobile/
# Without a key, /ai/assist still works with rule-based fallback replies.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_ENABLED=true
